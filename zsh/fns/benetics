# Create a new git worktree via scripts/setup-worktree.sh and, if running
# inside tmux, open a tdl layout for it in a new window.
# Usage: tdlw <ai> [<ai2>] -- <branch-name> [setup-worktree.sh args...]
tdlw() {
  local usage="Usage: tdlw <ai> [<ai2>] -- <branch-name> [setup-worktree.sh args...]"
  git rev-parse --git-dir >/dev/null 2>&1 || { echo "Not in a git repo."; return 1; }

  local ai="" ai2=""
  case $# in
    0|1) echo "$usage"; return 1 ;;
  esac
  ai="$1"; shift
  if [[ $1 != -- ]]; then
    ai2="$1"; shift
  fi
  [[ $1 == -- ]] || { echo "$usage"; return 1; }
  shift
  [[ -z $1 ]] && { echo "tdlw: missing branch name."; return 1; }

  local main_root before after newpath pane_id
  # setup-worktree.sh anchors paths to wherever it runs, so run it from the
  # main checkout (the first entry of `git worktree list`).
  main_root=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}')
  before=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' | sort)
  ( cd "$main_root" && scripts/setup-worktree.sh "$@" ) || return 1
  after=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' | sort)
  newpath=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -1)

  if [[ -z $newpath ]]; then
    echo "tdlw: worktree created, but couldn't auto-detect its path."
    return 1
  fi

  if [[ -n $TMUX ]]; then
    pane_id=$(tmux new-window -c "$newpath" -P -F '#{pane_id}')
    tmux send-keys -t "$pane_id" "tdl $ai $ai2" C-m
  else
    echo "tdlw: created $newpath (not in tmux)."
  fi
}

# Tear down the current worktree and its tmux window. Always removes the
# worktree; removes the branch only if all its commits have landed on
# origin/main (detected by patch-id via `git cherry`, so rebase/squash
# merges count as landed). Refuses dirty state unless --force, which also
# promotes branch deletion to unconditional.
# Usage: twrm [--force]
twrm() {
  local force=false
  if [[ $1 == --force ]]; then
    force=true
    shift
  fi
  [[ $# -gt 0 ]] && { echo "Usage: twrm [--force]"; return 1; }

  git rev-parse --git-dir >/dev/null 2>&1 || { echo "Not in a git repo."; return 1; }

  local current_root main_root branch
  current_root=$(git rev-parse --show-toplevel)
  main_root=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}')

  if [[ $current_root == $main_root ]]; then
    echo "twrm: refusing to remove the main worktree."
    return 1
  fi

  branch=$(git branch --show-current)
  if [[ -z $branch ]]; then
    echo "twrm: detached HEAD — no branch to deal with."
    return 1
  fi

  if [[ -n $(git status --porcelain) ]] && ! $force; then
    echo "twrm: worktree is dirty. Commit, stash, or rerun with --force."
    return 1
  fi

  echo "twrm: fetching origin/main..."
  git fetch origin main || { echo "twrm: git fetch origin main failed."; return 1; }

  # Leave the doomed directory before removing it.
  cd "$main_root" || return 1

  echo "twrm: removing $current_root..."
  if $force; then
    git worktree remove --force "$current_root" || return 1
  else
    git worktree remove "$current_root" || return 1
  fi

  # `git cherry` compares by patch-id, so it correctly reports rebase- and
  # squash-merged commits as landed (where `git branch -d`'s SHA check fails).
  # `-D` is used because rebase changes SHAs even when patches are identical.
  if git cherry origin/main "$branch" | grep -q '^+ '; then
    if $force; then
      git branch -D "$branch" >/dev/null
      echo "twrm: removed $current_root and branch $branch (--force; unmerged commits discarded)."
    else
      echo "twrm: removed $current_root; kept branch $branch (has unmerged commits)."
    fi
  else
    git branch -D "$branch" >/dev/null
    echo "twrm: removed $current_root and branch $branch (fully landed on origin/main)."
  fi

  [[ -n $TMUX ]] && tmux kill-window
}
