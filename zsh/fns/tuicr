# Review the current branch in tuicr: commits since it diverged from the default
# branch (as worktrunk defines it, which is what wt-created worktrees branch
# from) plus staged and unstaged changes. With no branch commits, review just
# the working tree. tuicr refuses to start when asked to review nothing, so a
# clean tree with no branch commits (e.g. a fresh worktree) gets bare tuicr.
# Usage: review [tuicr args...]
review() {
  local base count=0
  base=$(wt step eval '{{ default_branch }}' 2>/dev/null)
  [[ -n $base ]] && count=$(git rev-list --count "$base..HEAD" 2>/dev/null || echo 0)

  if (( count > 0 )); then
    tuicr -r "$base..HEAD" -w "$@"
  elif [[ -n $(git status --porcelain 2>/dev/null) ]]; then
    tuicr -w "$@"
  else
    tuicr "$@"
  fi
}
